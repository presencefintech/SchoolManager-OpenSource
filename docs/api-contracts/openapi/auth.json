{
  "openapi": "3.0.3",
  "info": {
    "title": "Presence — API Auth (Mobile & Web)",
    "version": "1.0.0",
    "description": "Authentification centralisée pour l'app **Flutter parent** (et autres rôles).\n\n**Base URL:** `{host}/api/v1/auth`\n\n**Specs complémentaires (sans doublon):**\n- [`openapi-parent-mobile.json`](./openapi-parent-mobile.json) — dashboard, élèves, classes, onboarding `activate-access`\n- [`openapi-parent-finances.json`](./openapi-parent-finances.json) — paiements, wallet, Payment Intent\n\n**Après login parent:** enregistrer le token FCM via `POST /api/v1/mobile/parents/notifications/register-token` (canal parent). `PATCH /push-token` ici est le endpoint auth générique (web / legacy).\n\n**Format succès habituel:** `{ status: \"success\", token?, refreshToken?, user?, tenant?, message? }`\n\n**Tenant (ADR-002):** `tenant: { id, schoolId, slug? }` renvoyé au login / verify-otp / refresh — utiliser `tenant.id` pour `X-Tenant-Id` et Socket `auth.tenantId`.\n\n**Format erreur:** `{ success: false, message, errors?, statusCode }`"
  },
  "servers": [
    {
      "url": "http://localhost:5000/api/v1/auth",
      "description": "Développement local"
    },
    {
      "url": "https://gestion-presence-et-paiement-mobile.onrender.com/api/v1/auth",
      "description": "Staging Render"
    }
  ],
  "tags": [
    {
      "name": "Session",
      "description": "Login, OTP, tokens"
    },
    {
      "name": "Account",
      "description": "Activation staff, mot de passe"
    },
    {
      "name": "Profile",
      "description": "Profil et MFA (JWT requis)"
    }
  ],
  "paths": {
    "/login": {
      "post": {
        "tags": [
          "Session"
        ],
        "summary": "Connexion email/téléphone + mot de passe",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Succès ou MFA requis",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AuthTokensResponse"
                    },
                    {
                      "$ref": "#/components/schemas/MfaRequiredResponse"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/InvalidCredentials"
          }
        }
      }
    },
    "/request-otp": {
      "post": {
        "tags": [
          "Session"
        ],
        "summary": "Demander un code OTP (SMS)",
        "description": "Compte **déjà actif** uniquement. Ne active pas le compte.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpRequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP envoyé",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Code OTP envoye avec succes."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "description": "Compte introuvable dans l'établissement ou plafond OTP (15 min)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "examples": {
                  "userNotFound": {
                    "value": {
                      "success": false,
                      "message": "USER_NOT_FOUND_IN_THIS_SCHOOL",
                      "statusCode": 403
                    }
                  },
                  "rateLimit": {
                    "value": {
                      "success": false,
                      "message": "TOO_MANY_OTP_REQUESTS",
                      "statusCode": 403
                    }
                  }
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/OtpCooldown"
          },
          "503": {
            "$ref": "#/components/responses/SmsUnavailable"
          }
        }
      }
    },
    "/verify-otp": {
      "post": {
        "tags": [
          "Session"
        ],
        "summary": "Vérifier OTP et obtenir les tokens",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpVerifyBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connexion réussie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/InvalidOtp"
          }
        }
      }
    },
    "/activate": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Activer un compte staff (token invitation)",
        "description": "Pour les **parents**, utiliser `POST /api/v1/mobile/parents/activate-access`.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivateStaffBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Compte activé",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Compte active avec succes."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/forgot-password": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Demande de réinitialisation par email",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Réponse générique (anti-énumération)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Email envoye si le compte existe."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/reset-password": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Réinitialiser le mot de passe",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mot de passe mis à jour"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/refresh-token": {
      "post": {
        "tags": [
          "Session"
        ],
        "summary": "Renouveler l'access token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nouveaux tokens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/InvalidRefreshToken"
          }
        }
      }
    },
    "/profile": {
      "get": {
        "tags": [
          "Profile"
        ],
        "summary": "Profil utilisateur connecté",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "user": {
                      "$ref": "#/components/schemas/UserSession"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/change-password": {
      "post": {
        "tags": [
          "Profile"
        ],
        "summary": "Changer le mot de passe",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mot de passe modifié"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/mfa/init": {
      "get": {
        "tags": [
          "Profile"
        ],
        "summary": "Initialiser MFA (QR / secret)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Données MFA"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/logout": {
      "post": {
        "tags": [
          "Session"
        ],
        "summary": "Déconnexion (révoquer refresh token)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Déconnexion OK"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/logout-all": {
      "post": {
        "tags": [
          "Session"
        ],
        "summary": "Fermer toutes les sessions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Toutes les sessions fermées"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/push-token": {
      "patch": {
        "tags": [
          "Profile"
        ],
        "summary": "Mettre à jour le token FCM (auth générique)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushTokenBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token enregistré"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        },
        "description": "Endpoint auth transversal. **App Flutter parent:** préférer `POST /api/v1/mobile/parents/notifications/register-token`."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginBody": {
        "type": "object",
        "required": [
          "identifier",
          "password"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "minLength": 3,
            "description": "Email ou téléphone"
          },
          "password": {
            "type": "string",
            "minLength": 1
          },
          "mfaCode": {
            "type": "string",
            "minLength": 6,
            "maxLength": 6,
            "description": "Requis si MFA activé"
          }
        }
      },
      "OtpRequestBody": {
        "type": "object",
        "required": [
          "phone",
          "schoolId"
        ],
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 6
          },
          "schoolId": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "OtpVerifyBody": {
        "type": "object",
        "required": [
          "phone",
          "code",
          "schoolId"
        ],
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 6
          },
          "code": {
            "type": "string",
            "minLength": 6,
            "maxLength": 6
          },
          "schoolId": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "ActivateStaffBody": {
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "properties": {
          "token": {
            "type": "string",
            "minLength": 10
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "Min 8 car., 1 majuscule, 1 chiffre"
          }
        }
      },
      "ResetPasswordBody": {
        "type": "object",
        "required": [
          "token",
          "newPassword"
        ],
        "properties": {
          "token": {
            "type": "string",
            "minLength": 10
          },
          "newPassword": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "RefreshTokenBody": {
        "type": "object",
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 20
          }
        }
      },
      "ChangePasswordBody": {
        "type": "object",
        "required": [
          "oldPassword",
          "newPassword"
        ],
        "properties": {
          "oldPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "PushTokenBody": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "minLength": 10
          },
          "type": {
            "type": "string",
            "enum": [
              "FCM",
              "WEB",
              "IOS"
            ],
            "default": "FCM"
          },
          "platform": {
            "type": "string"
          }
        }
      },
      "UserSession": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "example": "PARENT"
          },
          "schoolId": {
            "type": "integer",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          },
          "language": {
            "type": "string"
          }
        }
      },
      "AuthTokensResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "token": {
            "type": "string",
            "description": "JWT access token"
          },
          "refreshToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserSession"
          }
        }
      },
      "MfaRequiredResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "mfaRequired": {
            "type": "boolean",
            "example": true
          },
          "userId": {
            "type": "integer"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "validation": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "statusCode": {
            "type": "integer"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "JWT manquant ou expiré",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Accès refusé",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Erreur Zod",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "InvalidCredentials": {
        "description": "Identifiants invalides ou compte inactif",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "success": false,
              "message": "INVALID_CREDENTIALS",
              "statusCode": 403
            }
          }
        }
      },
      "InvalidOtp": {
        "description": "OTP invalide ou expiré",
        "content": {
          "application/json": {
            "example": {
              "success": false,
              "message": "INVALID_OR_EXPIRED_OTP",
              "statusCode": 403
            }
          }
        }
      },
      "InvalidRefreshToken": {
        "description": "Refresh token invalide",
        "content": {
          "application/json": {
            "example": {
              "success": false,
              "message": "INVALID_REFRESH_TOKEN",
              "statusCode": 403
            }
          }
        }
      },
      "OtpCooldown": {
        "description": "Cooldown actif entre deux demandes OTP (60 s par défaut)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "success": false,
              "message": "Veuillez patienter avant de redemander un code.",
              "statusCode": 429,
              "errors": {
                "code": "OTP_COOLDOWN",
                "retryAfterSeconds": 60
              }
            }
          }
        }
      },
      "SmsUnavailable": {
        "description": "Échec livraison SMS (provider indisponible ou credentials invalides)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "success": false,
              "message": "Impossible d'envoyer le SMS. Réessayez dans quelques instants ou contactez l'école.",
              "statusCode": 503,
              "errors": {
                "code": "SMS_DELIVERY_FAILED"
              }
            }
          }
        }
      }
    }
  }
}
